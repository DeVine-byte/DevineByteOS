module sales enable {
    entity Order {
        id: String;
        status: String;
    }

    workflow FulfillOrder {
        ReserveInventory;
        OrderCreated;
    }

    event OrderCreated();
}

module inventory depends on sales enable {
    entity Stock {
        sku: String;
        qty: Int;
    }
}

module runtime enable {
    event SystemBooted();
}
