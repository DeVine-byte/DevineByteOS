// ==========================================================
// MODULE 1: PATIENT MANAGEMENT = CRM
// ==========================================================
module crm enable {
    entity Patient {
        id: String;
        name: String;
        email: String;
        phone: String;
        dob: DateTime;
        gender: String;
        bloodGroup: String;
        address: String;
        createdAt: DateTime;
        expose api [GET, POST, PUT];
    }

    event PatientRegistered {
        payload: {
            patientId: String,
            name: String,
            phone: String
        }
    }
}

// ==========================================================
// MODULE 2: BILLING & APPOINTMENTS = SALES
// ==========================================================
module sales depends on crm enable {
    entity Appointment {
        id: String;
        patientId: String;
        doctorId: String;
        department: String;
        appointmentDate: DateTime;
        status: String;
        total: Decimal;
        expose api [GET, POST, PUT];
    }

    entity Invoice {
        id: String;
        appointmentId: String;
        patientId: String;
        amount: Decimal;
        status: String;
        expose api [GET, POST];
    }

    event AppointmentBooked {
        payload: {
            appointmentId: String,
            patientId: String,
            department: String
        }
    }

    workflow PatientCheckinToDischarge {
        ReserveBed;
        AssignDoctor;
        ProcessBilling;
        DischargePatient;
    }

    kpi AppointmentConversionRate: AppointmentsCompleted;

}

// ==========================================================
// MODULE 3: PHARMACY & SUPPLIES = INVENTORY
// ==========================================================
module inventory depends on sales enable {
    entity Stock {
        sku: String;
        name: String;
        qty: Int;
        unit: String;
        warehouse: String;
        expiryDate: DateTime;
        expose api [GET, PUT];
    }

    entity Prescription {
        id: String;
        appointmentId: String;
        patientId: String;
        drugSku: String;
        dosage: String;
        status: String;
        expose api [GET, POST];
    }

    event MedicationDispensed {
        payload: {
            prescriptionId: String,
            appointmentId: String,
            status: String
        }
    }
}

// ==========================================================
// MODULE 4: INSURANCE & PAYMENTS = FINANCE
// ==========================================================
module finance depends on inventory enable {
    entity Payment {
        id: String;
        invoiceId: String;
        appointmentId: String;
        patientId: String;
        amount: Decimal;
        method: String;
        status: String;
        expose api [GET];
    }

    entity InsuranceClaim {
        id: String;
        invoiceId: String;
        hmoCode: String;
        status: String;
        expose api [GET, POST];
    }

    event PaymentConfirmed {
        payload: {
            paymentId: String,
            invoiceId: String,
            status: String
        }
    }
}

