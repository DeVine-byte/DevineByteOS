module crm enable {
    entity Patient {
        id: String;
        name: String;
        email: String;
        phone: String;
        dob: Date;
        gender: String;
        bloodGroup: String;
        address: String;
        createdAt: DateTime;
        expose api [GET, POST, PUT];
    }

    event PatientRegistered {
        payload: {
            patientId: String,
            name: String,
            phone: String
        }
    }
}

// ==========================================================
// MODULE 2: BILLING & APPOINTMENTS = SALES
// ==========================================================
module sales depends on crm enable {
    entity Appointment {
        id: String;
        patientId: String; // FK to crm.Patient
        doctorId: String;
        department: String; // Cardiology, Radiology, etc
        appointmentDate: DateTime;
        status: String; // SCHEDULED, CHECKED_IN, COMPLETED, CANCELLED
        total: Decimal;
        expose api [GET, POST, PUT];
    }

    entity Invoice {
        id: String;
        appointmentId: String; // FK to sales.Appointment
        patientId: String; // FK to crm.Patient
        amount: Decimal;
        status: String; // PENDING, PAID, INSURANCE_CLAIM
        expose api [GET, POST];
    }

    // EXPOSES: The initial trigger to start clinical workflow
    event AppointmentBooked {
        payload: {
            appointmentId: String,
            patientId: String,
            department: String
        }
    }

    workflow PatientCheckinToDischarge {
        ReserveBed;
        AssignDoctor;
        ProcessBilling;
        DischargePatient;
    }

    // KPI mapping definition used in Phase 4 Step 5
    kpi AppointmentConversionRate: AppointmentsCompleted;
}

// ==========================================================
// MODULE 3: PHARMACY & SUPPLIES = INVENTORY
// ==========================================================
module inventory depends on sales enable {
    entity Stock {
        sku: String; // DrugCode, ConsumableCode
        name: String;
        qty: Int;
        unit: String; // mg, pcs, ml
        warehouse: String; // Main Pharmacy, ER Store
        expiryDate: Date;
        expose api [GET, PUT];
    }

    entity Prescription {
        id: String;
        appointmentId: String;
        patientId: String;
        drugSku: String;
        dosage: String;
        status: String; // ISSUED, DISPENSED
        expose api [GET, POST];
    }

    // EXPOSES: Allows Pharmacy to notify Finance
    event MedicationDispensed {
        payload: {
            prescriptionId: String,
            appointmentId: String,
            status: String
        }
    }
}

// ==========================================================
// MODULE 4: INSURANCE & PAYMENTS = FINANCE
// ==========================================================
module finance depends on inventory enable {
    entity Payment {
        id: String;
        invoiceId: String;
        appointmentId: String;
        patientId: String;
        amount: Decimal;
        method: String; // CASH, CARD, HMO, INSURANCE
        status: String; // SUCCESS, FAILED
        expose api [GET];
    }

    entity InsuranceClaim {
        id: String;
        invoiceId: String;
        hmoCode: String;
        status: String; // SUBMITTED, APPROVED, REJECTED
        expose api [GET, POST];
    }

    // EXPOSES: Final step event before discharge
    event PaymentConfirmed {
        payload: {
            paymentId: String,
            invoiceId: String,
            status: String
        }
    }
}

// ==========================================================
// MODULE 5: CLINICAL = CORE HOSPITAL OPS
// ==========================================================
module clinical depends on sales enable {
    entity MedicalRecord {
        id: String;
        patientId: String;
        appointmentId: String;
        diagnosis: String;
        notes: String;
        doctorId: String;
        createdAt: DateTime;
        expose api [GET, POST];
    }

    entity Bed {
        id: String;
        ward: String; // ICU, General, Maternity
        status: String; // AVAILABLE, OCCUPIED, MAINTENANCE
        expose api [GET, PUT];
    }

    event PatientDischarged {
        payload: {
            appointmentId: String,
            patientId: String,
            status: String
        }
    }
}

module runtime enable {
    event SystemBooted();
}

